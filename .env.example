# 이 파일을 복사해서 .env를 만듭니다:  cp .env.example .env   (Windows: copy .env.example .env)
# .env는 절대 커밋하지 않습니다 (.gitignore에 들어 있음)

# ---- 실행 모드 ----
# memory: OpenSearch·Postgres 없이 (인프라 1단계, 빠른 확인) / real: docker compose로 띄운 OpenSearch·Postgres 사용
BACKEND=real
# 에이전트가 쓸 도구: mock(가짜, mocks.py) / real(직접 만든 것). 2일차 1-1에서 하나씩 real로 바꿉니다
TELEMETRY_TOOLS=mock
KB_TOOLS=mock

# ---- 연결 주소 ----
OPENSEARCH_URL=http://localhost:9200
POSTGRES_PASSWORD=soc   # 내 PC 실습용 값. docker-compose.yml이 읽습니다 (DSN의 비밀번호와 같아야 함)
POSTGRES_DSN=postgresql://soc:soc@localhost:5432/soc

# ---- LLM ----
OPENAI_API_KEY=sk-여기에-키
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# true면 API 키 없이 가짜 LLM으로 흐름만 확인
FAKE_LLM=false

# ---- LangSmith 추적 (선택) ----
# 켜면 에이전트가 어떤 도구를 몇 번 불렀는지, 단계별 시간과 토큰을 smith.langchain.com에서 볼 수 있습니다
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2-여기에-키
LANGSMITH_PROJECT=edr-triage
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- 에이전트 ----
# 가드레일이 실패하면: retry(한 번 더 조사 후 낮춤) / downgrade(바로 '의심'으로 낮춤). 2일차 1-2에서 둘이 정합니다
GUARDRAIL_ON_FAIL=retry
# 상태 저장: auto(BACKEND=real이면 postgres) / memory / postgres. 2일차 1-3 실험에서 바꿔 봅니다
CHECKPOINTER=auto
PROMPT_VERSION=v1
# 처리 중인 워커가 죽으면 이 시간(초)이 지난 뒤 다른 워커가 그 알림을 이어 받습니다 (인프라 4-5 깨 보기는 30~60으로 줄여서)
WORKER_LEASE_SEC=300

# ---- 비용 계산 (agent_eval의 알림당 비용, USD / 토큰 100만 개) ----
PRICE_IN_PER_1M=0.15
PRICE_OUT_PER_1M=0.60

# ---- KB (📘) ----
PARSE_STRATEGY=fast
CHUNK_MAX_CHARACTERS=800

# ---- Dify (3일차) ----
DIFY_API_KEY=change-me
